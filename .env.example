# These four are plain `vars` in wrangler.jsonc (not secrets) — edit them
# there directly for each environment (top-level = staging, env.production =
# production). This file just documents what they mean; it isn't loaded by
# anything.

# Canonical site URL used for SEO (canonical links, sitemap, JSON-LD).
# This deploys as a Worker with Static Assets, so the staging URL is a
# workers.dev subdomain (`wrangler deploy` prints the real one on first
# deploy) — not pages.dev. Staging example: https://grontals.acme.workers.dev
# Production: https://xn--grntals-r1a.no
PUBLIC_SITE_URL=https://grontals.YOUR-SUBDOMAIN.workers.dev

# Phone number shown for "Bestill på telefon" (E.164 or national format).
ORDER_PHONE_NUMBER=+47 000 00 000

# "true" disables indexing in robots.txt (safe default on the workers.dev
# staging URL). Set to "false" only once the real domain is live — see
# README's domain checklist.
DISALLOW_INDEXING=true

# Google Analytics 4 measurement id (e.g. "G-XXXXXXXXXX"). Leave empty to
# disable — gtag.js is only injected, and CSP only relaxed for it, when set.
GA4_MEASUREMENT_ID=

# Google Search Console HTML-tag verification value (the content="..." Google
# gives you, not the whole <meta> tag). Leave empty if you verify via DNS
# TXT record instead (recommended — no code/deploy needed for that method).
GSC_VERIFICATION_META=

# --- Secrets (never go in wrangler.jsonc) ---
# Copy the ADMIN_SESSION_SECRET line from .dev.vars.example into your own
# .dev.vars for local dev; use `wrangler secret put ADMIN_SESSION_SECRET`
# for each deployed environment. The admin password itself isn't an env
# var — it's set with `npm run db:create-admin -- <username> <password>`.
